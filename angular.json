				},
				"@schematics/angular:resolver": {
					"skipTests": true
				},
				"@schematics/angular:service": {
					"skipTests": true
				}
			},
			"root": "notifications",
			"sourceRoot": "notifications/src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular-architects/native-federation-v4:build",
					"options": {
						"cacheExternalArtifacts": true,
						"tsConfig": "notifications/tsconfig.federation.json"
					},
					"configurations": {
						"production": {
