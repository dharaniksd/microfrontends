				},
				"serve": {
					"builder": "@angular-architects/native-federation-v4:build",
					"options": {
						"target": "notifications:serve-original:development",
						"tsConfig": "notifications/tsconfig.federation.json",
						"rebuildDelay": 500,
						"cacheExternalArtifacts": true,
						"dev": true,
						"devServer": true,
						"port": 0
					}
				},
				"esbuild": {
					"builder": "@angular/build:application",
					"options": {
						"browser": "notifications/src/main.ts",
						"tsConfig": "notifications/tsconfig.app.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "notifications/public"
							}
						],
						"styles": [
							"notifications/src/styles.scss"
						],
						"polyfills": [
							"es-module-shims"
						]
					},
					"configurations": {
						"production": {
							"budgets": [
								{
									"type": "initial",
